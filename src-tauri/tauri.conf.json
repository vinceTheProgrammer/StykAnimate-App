{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StykAnimate",
  "version": "0.1.0",
  "identifier": "com.stykanimate.app",
  "build": {
    "frontendDist": "../build/web",
    "beforeDevCommand": null,
    "beforeBuildCommand": "npm run web:build && npm run web:verify"
  },
  "app": {
    "windows": [
      {
        "title": "StykAnimate",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
